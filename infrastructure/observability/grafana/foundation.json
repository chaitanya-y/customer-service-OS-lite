{
  "uid": "cso-foundation",
  "title": "CSO local operational observability",
  "schemaVersion": 39,
  "version": 3,
  "tags": ["cso", "local", "safe-signals"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Platform observability",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Completed operations per second",
      "gridPos": { "x": 0, "y": 1, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (service_name) (rate(cso_operation_completed_total[5m]))", "legendFormat": "{{service_name}}" }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Operation duration p95",
      "gridPos": { "x": 12, "y": 1, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(cso_operation_duration_seconds_bucket[5m])))", "legendFormat": "{{service_name}}" }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Server error ratio",
      "gridPos": { "x": 0, "y": 9, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum by (service_name) (rate(cso_operation_completed_total{outcome=\"server_error\"}[5m])) / sum by (service_name) (rate(cso_operation_completed_total[5m]))", "legendFormat": "{{service_name}}" }]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Safe correlated request logs",
      "gridPos": { "x": 12, "y": 9, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "expr": "{service_name=~\"edge-api|agent-runtime|knowledge-rag|integration-gateway|human-operations|conversation-runtime\"}", "queryType": "range" }]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Model and RAG",
      "gridPos": { "x": 0, "y": 17, "w": 24, "h": 1 }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Model tokens per second",
      "gridPos": { "x": 0, "y": 18, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (operation) (rate(cso_model_tokens_total{service_name=\"agent-runtime\",operation=~\"model[.]refund_(answer|intent)\"}[5m]))", "legendFormat": "{{operation}}" }]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Model failure or guard-rejection ratio",
      "gridPos": { "x": 12, "y": 18, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum(rate(cso_operation_completed_total{service_name=\"agent-runtime\",operation=~\"model[.]refund_(answer|intent)\",outcome=~\"model_error|guard_rejected\"}[5m])) / sum(rate(cso_operation_completed_total{service_name=\"agent-runtime\",operation=~\"model[.]refund_(answer|intent)\"}[5m]))", "legendFormat": "model safety events" }]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "RAG phase duration p95",
      "gridPos": { "x": 0, "y": 26, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(cso_operation_duration_seconds_bucket{service_name=\"knowledge-rag\",operation=~\"rag[.].*\"}[5m])))", "legendFormat": "{{operation}}" }]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "RAG server error ratio",
      "gridPos": { "x": 12, "y": 26, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum(rate(cso_operation_completed_total{service_name=\"knowledge-rag\",operation=~\"rag[.].*\",outcome=\"server_error\"}[5m])) / sum(rate(cso_operation_completed_total{service_name=\"knowledge-rag\",operation=~\"rag[.].*\"}[5m]))", "legendFormat": "RAG errors" }]
    },
    {
      "id": 11,
      "type": "row",
      "title": "Refund operations",
      "gridPos": { "x": 0, "y": 34, "w": 24, "h": 1 }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Refund-path operation events (not distinct refunds)",
      "gridPos": { "x": 0, "y": 35, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (operation, outcome) (rate(cso_operation_completed_total{service_name=\"agent-runtime\",operation=~\"mcp[.]lookup_order|model[.]refund_(answer|intent)|answer[.]fallback\"}[5m]))", "legendFormat": "{{operation}} {{outcome}}" }]
    },
    {
      "id": 13,
      "type": "table",
      "title": "Temporal activity traces (trace-only)",
      "gridPos": { "x": 12, "y": 35, "w": 12, "h": 8 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [{ "refId": "A", "queryType": "traceql", "expr": "{ resource.service.name = \"workflow-workers\" && span.operation =~ \"temporal\\\\.activity\\\\..*\" }" }]
    },
    {
      "id": 14,
      "type": "text",
      "title": "Refund operations coverage",
      "gridPos": { "x": 0, "y": 43, "w": 24, "h": 4 },
      "options": { "mode": "markdown", "content": "The refund execution and backlog panels are authoritative periodic snapshots of durable PostgreSQL state. Temporal activity attempts can retry, remain trace-only and are not distinct refunds. Metrics are diagnostic views; durable audit records remain the authorization and money-movement authority." }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Authoritative refund executions",
      "gridPos": { "x": 0, "y": 47, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (outcome) (cso_refund_executions_current{service_name=\"integration-gateway\"})", "legendFormat": "{{outcome}}" }]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Refund and provider backlog age",
      "gridPos": { "x": 8, "y": 47, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "cso_refund_executions_oldest_age_seconds{service_name=\"integration-gateway\"}", "legendFormat": "refund {{outcome}}" },
        { "refId": "B", "expr": "cso_refund_provider_events_oldest_age_seconds{service_name=\"integration-gateway\"}", "legendFormat": "provider event" }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Pending durable outbox records",
      "gridPos": { "x": 16, "y": 47, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "cso_refund_provider_events_pending{service_name=\"integration-gateway\"}", "legendFormat": "provider events" },
        { "refId": "B", "expr": "cso_human_operations_decision_outbox_pending{service_name=\"human-operations\"}", "legendFormat": "human decisions" }
      ]
    },
    {
      "id": 15,
      "type": "row",
      "title": "Telemetry health",
      "gridPos": { "x": 0, "y": 55, "w": 24, "h": 1 }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Emitted operation samples by service",
      "gridPos": { "x": 0, "y": 56, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (service_name) (increase(cso_operation_completed_total[15m]))", "legendFormat": "{{service_name}}" }]
    },
    {
      "id": 17,
      "type": "text",
      "title": "Telemetry health limits",
      "gridPos": { "x": 16, "y": 56, "w": 8, "h": 8 },
      "options": { "mode": "markdown", "content": "Heartbeat series distinguish an idle enabled service from missing telemetry. Missing-service alerts require a previously observed heartbeat. Collector internal metrics expose enqueue and send failures. These local alerts do not notify an external destination and do not replace durable audit." }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Service telemetry heartbeat",
      "gridPos": { "x": 8, "y": 56, "w": 4, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "max by (service_name) (cso_telemetry_heartbeat)", "legendFormat": "{{service_name}}" }]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Collector export failures",
      "gridPos": { "x": 12, "y": 56, "w": 4, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "(sum(rate(otelcol_exporter_send_failed_spans_total[5m])) or vector(0)) + (sum(rate(otelcol_exporter_send_failed_metric_points_total[5m])) or vector(0)) + (sum(rate(otelcol_exporter_send_failed_log_records_total[5m])) or vector(0)) + (sum(rate(otelcol_exporter_enqueue_failed_spans_total[5m])) or vector(0)) + (sum(rate(otelcol_exporter_enqueue_failed_metric_points_total[5m])) or vector(0)) + (sum(rate(otelcol_exporter_enqueue_failed_log_records_total[5m])) or vector(0))", "legendFormat": "failed signals/s" }]
    }
  ]
}
