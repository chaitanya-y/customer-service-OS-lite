{
  "uid": "cso-foundation",
  "title": "CSO service foundation",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["cso", "local"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Completed operations per second",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (service_name) (rate(cso_operation_completed_total[5m]))", "legendFormat": "{{service_name}}" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "Operation duration p95",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(cso_operation_duration_seconds_bucket[5m])))", "legendFormat": "{{service_name}}" }]
    },
    {
      "id": 3, "type": "timeseries", "title": "Server error ratio",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum by (service_name) (rate(cso_operation_completed_total{outcome=\"server_error\"}[5m])) / sum by (service_name) (rate(cso_operation_completed_total[5m]))", "legendFormat": "{{service_name}}" }]
    },
    {
      "id": 4, "type": "logs", "title": "Safe correlated request logs",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "expr": "{service_name=~\"edge-api|agent-runtime\"}", "queryType": "range" }]
    },
    {
      "id": 5, "type": "text", "title": "Read this dashboard correctly",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 4 },
      "options": { "mode": "markdown", "content": "Local foundation: Edge API and Agent Runtime only. Use Explore with Tempo to search traces and follow correlated logs. Synthetic smoke traffic is not live model performance. Empty rate panels need multiple export samples; no data does not mean zero errors. Refund business decisions and durable audit remain separate." }
    }
  ]
}
