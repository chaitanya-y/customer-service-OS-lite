{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://customer-service-os.example/contracts/workflows/policy/v1/refund-policy-decision",
  "title": "RefundPolicyDecisionV1",
  "description": "Deterministic Business Policy Service output for a refund. It is separate from platform authorization and workflow state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "decisionId",
    "journeyType",
    "effect",
    "policyVersion",
    "inputFactsHash",
    "factRefs",
    "reasonCodes",
    "obligations",
    "missingFacts",
    "decidedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "decisionId": {
      "$ref": "#/$defs/opaqueId"
    },
    "journeyType": {
      "const": "REFUND"
    },
    "effect": {
      "enum": [
        "ALLOW",
        "APPROVAL_REQUIRED",
        "TAKEOVER_REQUIRED",
        "DENY",
        "NEEDS_FACTS"
      ]
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "inputFactsHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "factRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/factRef"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "reasonCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "obligations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/obligation"
      },
      "uniqueItems": true
    },
    "missingFacts": {
      "type": "array",
      "items": {
        "enum": [
          "ORDER_STATUS",
          "PAYMENT_STATUS",
          "FULFILLMENT_STATUS",
          "REFUND_REASON",
          "ITEM_SELECTION",
          "JURISDICTION",
          "PRIOR_REFUND_HISTORY",
          "PURCHASE_DATE",
          "REQUESTED_AMOUNT",
          "REFUNDABLE_AMOUNT",
          "REFUND_DESTINATION",
          "CUSTOMER_VERIFICATION",
          "TRANSACTION_REFUNDABILITY",
          "DAMAGE_PHOTO"
        ]
      },
      "uniqueItems": true
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time"
    },
    "validUntil": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "effect": {
            "const": "NEEDS_FACTS"
          }
        },
        "required": [
          "effect"
        ]
      },
      "then": {
        "properties": {
          "missingFacts": {
            "type": "array",
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "missingFacts": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "effect": {
            "enum": [
              "APPROVAL_REQUIRED",
              "TAKEOVER_REQUIRED"
            ]
          }
        },
        "required": [
          "effect"
        ]
      },
      "then": {
        "properties": {
          "obligations": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "factRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factId",
        "factType",
        "sourceVersion",
        "observedAt"
      ],
      "properties": {
        "factId": {
          "$ref": "#/$defs/opaqueId"
        },
        "factType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "sourceVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "enum": [
            "REQUIRE_CUSTOMER_VERIFICATION",
            "REQUIRE_HUMAN_APPROVAL",
            "REQUIRE_TAKEOVER",
            "LIMIT_REFUND_AMOUNT",
            "REQUIRE_ORIGINAL_PAYMENT_METHOD",
            "REQUIRE_EVIDENCE"
          ]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "maxProperties": 10
        }
      }
    }
  }
}
