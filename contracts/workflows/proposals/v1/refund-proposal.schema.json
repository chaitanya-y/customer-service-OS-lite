{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://customer-service-os.example/contracts/workflows/proposals/v1/refund-proposal",
  "title": "RefundProposalV1",
  "description": "Untrusted but validated Agent Runtime proposal for the Temporal refund workflow. This contract never authorizes or executes a refund.",
  "$comment": "Reference output captured from a live gpt-5-nano intent-extraction test on 2026-08-02. This example is documentation only and never authorizes or executes a refund.",
  "examples": [
    {
      "schemaVersion": "1",
      "resultType": "JOURNEY_PROPOSAL",
      "proposalId": "a2314758-7916-46c8-9080-2682957667fb",
      "journeyType": "REFUND",
      "turnId": "turn-live-demo-1",
      "intent": {
        "orderId": "3",
        "reasonCode": "DAMAGED",
        "scope": "SELECTED_ITEMS",
        "itemIds": [
          "item-1"
        ]
      },
      "missingFields": [],
      "evidenceIds": [
        "observation-live-demo-1"
      ],
      "executionEvidence": {
        "schemaVersion": "1",
        "executionId": "2db22c81-1269-45cb-bcd8-cd7ec1148d0b",
        "scope": "TURN",
        "recordedAt": "2026-08-03T00:53:06.662846Z",
        "traceId": "trace-live-demo-1",
        "dependencies": {
          "agentReleaseId": "agent-runtime-0.1.0",
          "promptBundleVersion": "refund-intent-v1",
          "modelRouteId": "refund-intent-openai-v1",
          "knowledgeReleaseId": "knowledge-not-used",
          "guardrailVersion": "refund-proposal-guardrails-v1",
          "evaluationVersion": "evaluation-not-released",
          "toolContracts": [
            {
              "toolId": "lookup_order",
              "version": "lookup-order-v1"
            }
          ]
        },
        "evidenceRefs": [
          {
            "evidenceId": "observation-live-demo-1",
            "evidenceType": "TOOL_OBSERVATION",
            "sourceVersion": "1",
            "contentDigest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          }
        ]
      }
    }
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "resultType",
    "proposalId",
    "journeyType",
    "turnId",
    "intent",
    "missingFields",
    "evidenceIds",
    "executionEvidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "resultType": {
      "const": "JOURNEY_PROPOSAL"
    },
    "proposalId": {
      "$ref": "#/$defs/opaqueId"
    },
    "journeyType": {
      "const": "REFUND"
    },
    "turnId": {
      "$ref": "#/$defs/opaqueId"
    },
    "workflowRef": {
      "$ref": "#/$defs/workflowRef"
    },
    "intent": {
      "$ref": "#/$defs/refundIntent"
    },
    "missingFields": {
      "type": "array",
      "items": {
        "enum": [
          "ORDER_REFERENCE",
          "REFUND_REASON",
          "REFUND_SCOPE",
          "ITEM_SELECTION"
        ]
      },
      "uniqueItems": true
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/opaqueId"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "executionEvidence": {
      "$ref": "https://customer-service-os.example/contracts/ai-io/execution-evidence/v1"
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "workflowRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflowId",
        "expectedState",
        "expectedStateVersion"
      ],
      "properties": {
        "workflowId": {
          "$ref": "#/$defs/opaqueId"
        },
        "expectedState": {
          "enum": [
            "REQUESTED",
            "COLLECTING_INFORMATION",
            "CHECKING_ELIGIBILITY"
          ]
        },
        "expectedStateVersion": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "refundIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orderId",
        "reasonCode",
        "scope",
        "itemIds"
      ],
      "properties": {
        "orderId": {
          "$ref": "#/$defs/opaqueId"
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "scope": {
          "enum": [
            "FULL_ORDER",
            "SELECTED_ITEMS",
            "UNSPECIFIED"
          ]
        },
        "itemIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/opaqueId"
          },
          "uniqueItems": true
        },
        "requestedAmount": {
          "$ref": "#/$defs/money"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "SELECTED_ITEMS"
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "properties": {
              "itemIds": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scope": {
                "const": "FULL_ORDER"
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "properties": {
              "itemIds": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amountMinor",
        "currency"
      ],
      "properties": {
        "amountMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    }
  }
}
