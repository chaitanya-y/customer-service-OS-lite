{
  "name": "@customer-service-os/conversation-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Durable conversation and message owner for Customer Service OS",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env --import tsx src/bootstrap.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/bootstrap.js",
    "migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx tests/*.test.ts"
  },
  "dependencies": {
    "@cso/observability-node": "workspace:*",
    "fastify": "^5.10.0",
    "jose": "^6.2.4",
    "pg": "^8.16.3",
    "uuid": "^13.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opentelemetry/sdk-logs": "0.222.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.15.5",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
