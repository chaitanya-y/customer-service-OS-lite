{
  "name": "@customer-service-os/edge-api",
  "version": "0.1.0",
  "private": true,
  "description": "Customer-facing authentication and routing boundary for Customer Service OS",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env --import tsx src/server.ts",
    "local:token": "node --env-file=.env --import tsx src/local-token-cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx tests/*.test.ts"
  },
  "dependencies": {
    "@temporalio/client": "^1.22.0",
    "fastify": "^5.10.0",
    "jose": "^6.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
